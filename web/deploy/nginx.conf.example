# Examtopics behind nginx + php-fpm. Adjust server_name, paths and the php-fpm socket.
# Only web/public is exposed; app/, config/, storage/ and vendor/ are outside the root.
server {
    listen 443 ssl http2;
    server_name exams.example.com;

    ssl_certificate     /etc/letsencrypt/live/exams.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/exams.example.com/privkey.pem;

    root /srv/examtopics-downloader/web/public;
    index index.php;

    # Optional extra layer: only allow your own addresses (see docs/INSTALL.md).
    # allow 203.0.113.10;
    # deny all;

    client_max_body_size 1m;

    location /assets/ {
        try_files $uri =404;
        expires 7d;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        # PDF generation for large exams can take a while.
        fastcgi_read_timeout 300s;
    }

    # Never execute or serve any other PHP file, dotfile or backup.
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}

server {
    listen 80;
    server_name exams.example.com;
    return 301 https://$host$request_uri;
}
